{
  "$schema": "https://raw.githubusercontent.com/atampy25/simple-mod-framework/main/Mod%20Manager/src/lib/manifest-schema.json",
  "version": "1.0.0",
  "id": "Charc0al.SlowPoisons",
  "name": "Slow Poison",
  "description": "Delays the effects of various poisons on NPCs. Can select which types of poison this applies to.",
  "authors": [
    "Charc0al"
  ],
  "frameworkVersion": "2.25.1",
  "options": [
    {
      "name": "Lethal",
      "tooltip": "30 second delay for lethal poisons",
      "type": "checkbox",
      "enabledByDefault": true,
      "contentFolders": [
        "content/lethal"
      ]
    },
    {
      "name": "Emetic",
      "tooltip": "30 second delay for emetic poisons",
      "type": "checkbox",
      "enabledByDefault": true,
      "contentFolders": [
        "content/emetic"
      ]
    },
    {
      "name": "Sedative",
      "tooltip": "30 second delay for sedative poisons",
      "type": "checkbox",
      "enabledByDefault": true,
      "contentFolders": [
        "content/sedative"
      ]
    }
  ],
  "updateCheck": "https://github.com/charc0al/HM3_SlowPoison/releases/latest/download/updates.json",
  "contentFolders": [
    "content/main"
  ]
}
